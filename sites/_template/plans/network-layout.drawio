        <mxCell id="network" value="Network" parent="0"/>
        <mxCell id="keytitle" value="Key" style="text;html=1;fontStyle=1;fontSize=13;align=left;" vertex="1" parent="network"><mxGeometry x="40" y="10" width="100" height="24" as="geometry"/></mxCell>
        <mxCell id="key0" value="AP-01" style="ellipse;html=1;aspect=fixed;fillColor=#4CC3E6;strokeColor=#050B14;strokeWidth=2;fontSize=11;fontStyle=1;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="network"><mxGeometry x="40" y="40" width="28" height="28" as="geometry"/></mxCell><mxCell id="keyt0" value="Access point (indoor)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="network"><mxGeometry x="110" y="40" width="200" height="28" as="geometry"/></mxCell><mxCell id="key1" value="AP-02" style="ellipse;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#4CC3E6;strokeWidth=3;fontSize=11;fontStyle=1;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="network"><mxGeometry x="40" y="112" width="28" height="28" as="geometry"/></mxCell><mxCell id="keyt1" value="Access point (outdoor)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="network"><mxGeometry x="110" y="112" width="200" height="28" as="geometry"/></mxCell><mxCell id="key2" value="SW-01" style="rounded=0;html=1;fillColor=#050B14;strokeColor=#050B14;fontSize=11;fontStyle=1;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="network"><mxGeometry x="40" y="184" width="32" height="24" as="geometry"/></mxCell><mxCell id="keyt2" value="Switch" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="network"><mxGeometry x="110" y="184" width="200" height="24" as="geometry"/></mxCell><mxCell id="key3" value="GW" style="triangle;direction=north;html=1;fillColor=#F2B84B;strokeColor=#050B14;fontSize=11;fontStyle=1;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="network"><mxGeometry x="40" y="252" width="32" height="28" as="geometry"/></mxCell><mxCell id="keyt3" value="Gateway / UniFi console" style="text;html=1;align=left