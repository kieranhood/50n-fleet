# {{ ansible_managed }}: made from 50n-fleet (sites/{{ inventory_hostname }}/secrets.sops.yml). Don't edit here.
TRUST_PROXY=false
PORTAL_VERSION={{ portal_version }}
{% for client in portal_clients %}
{% set prefix = client.id | upper | replace('-', '_') %}
{% set login = (site_secrets.unifi_logins | default({}))[client.id] | default({}) %}
{{ prefix }}_UNIFI_API_KEY={{ (site_secrets.unifi_api_keys | default({}))[client.id] | default('') }}
{{ prefix }}_UNIFI_USERNAME={{ login.username | default('') }}
{{ prefix }}_UNIFI_PASSWORD={{ login.password | default('') }}
{% endfor %}
